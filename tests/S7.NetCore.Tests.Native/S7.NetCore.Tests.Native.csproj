<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(S7TestTargetFramework)</TargetFramework>
    <AssemblyName>S7.NetCore.Tests.Native</AssemblyName>
    <RootNamespace>S7.NetCore.Tests.Native</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <NoWarn>CS8073;CS8618;CS0168;CS0169;CS0649;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\S7.NetCore.Tests\snap7.net.cs" Link="snap7.net.cs" />
    <Compile Include="NativeServerInterop.cs" />
  </ItemGroup>

</Project>