<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>S7.NetCore</RootNamespace>
    <AssemblyName>S7.NetCore</AssemblyName>
    <PackageId>Snap7.NetCore</PackageId>
    <Description>Communicate with Siemens PLC using the S7 protocol.
使用S7协议与西门子PLC通讯</Description>
    <Authors>Giant</Authors>
    <Copyright>Copyright (c) 2026 Giant</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Giant150/S7.NetCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Giant150/S7.NetCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>siemens;s7;plc;s7-1200;s7-1500;industrial-automation</PackageTags>
    <Title>S7.NetCore</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="S7.NetCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>