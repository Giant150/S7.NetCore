<Window x:Class="S7.NetCore.Tools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:S7.NetCore.Tools.Views"
        Title="{Binding Title}"
        Height="860"
        Width="1440"
        MinHeight="640"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#EEF2F7" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="状态：" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StateText}" FontWeight="Bold" Foreground="#1F6FEB" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PduText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BusyText}" Margin="16,0,0,0" Foreground="DarkOrange" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding OperationBlockedReason}" Foreground="#B45309" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <Button Content="{Binding WriteProtectionText}" Command="{Binding ToggleWriteProtectionCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="断开" Command="{Binding DisconnectCommand}" Padding="12,4" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding VersionText}" Foreground="#555" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="状态时间线" Margin="8">
                <ListBox ItemsSource="{Binding Timeline}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PreviousState, Converter={StaticResource EnumDescriptionConverter}}" />
                                    <TextBlock Text=" → " />
                                    <TextBlock Text="{Binding CurrentState, Converter={StaticResource EnumDescriptionConverter}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Reason}" Foreground="#666" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <TabControl Grid.Column="1" Margin="8">
                <TabItem Header="连接">
                    <views:ConnectionView DataContext="{Binding Connection}" />
                </TabItem>
                <TabItem Header="原始字节读写">
                    <views:ByteAccessView DataContext="{Binding ByteAccess}" />
                </TabItem>
                <TabItem Header="类型化读写">
                    <views:TypedAccessView DataContext="{Binding TypedAccess}" />
                </TabItem>
                <TabItem Header="操作日志">
                    <views:LogView DataContext="{Binding Log}" />
                </TabItem>
            </TabControl>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding ReconnectProgressText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>