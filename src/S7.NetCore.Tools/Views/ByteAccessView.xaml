<UserControl x:Class="S7.NetCore.Tools.Views.ByteAccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <GroupBox Header="地址与参数">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="区域" Width="120" VerticalAlignment="Center" />
                        <ComboBox Width="220" ItemsSource="{Binding Areas}" SelectedItem="{Binding Area}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="DB 号" Width="120" VerticalAlignment="Center" />
                        <TextBox Width="220" IsEnabled="{Binding IsDbEnabled}" Text="{Binding DbNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="起始字节" Width="120" VerticalAlignment="Center" />
                        <TextBox Width="220" Text="{Binding StartByte, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="读取长度" Width="120" VerticalAlignment="Center" />
                        <TextBox Width="220" Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="十六进制分组" Width="120" VerticalAlignment="Center" />
                        <ComboBox Width="220" ItemsSource="{Binding GroupSizes}" SelectedItem="{Binding GroupSize}" />
                    </StackPanel>
                    <CheckBox Content="写入后回读校验" IsChecked="{Binding VerifyAfterWrite}" Margin="0,8,0,0" />
                    <TextBlock Text="PLC 输入区只读，写入命令不可用。"
                               Foreground="#B45309"
                               Margin="0,8,0,0"
                               Visibility="{Binding IsInputArea, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="写入数据（十六进制）" Margin="0,10,0,0">
                <StackPanel Margin="8">
                    <TextBox Height="100"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="读取" Command="{Binding ReadCommand}" Padding="20,6" Margin="0,0,8,0" />
                        <Button Content="写入" Command="{Binding WriteCommand}" Padding="20,6" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="结果" Margin="0,10,0,0">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="请求字节数：" />
                        <TextBlock Text="{Binding RequestedLengthText}" />
                        <TextBlock Text="  返回字节数：" Margin="16,0,0,0" />
                        <TextBlock Text="{Binding ReturnedLengthText}" />
                    </StackPanel>
                    <TextBlock Text="十六进制" Margin="0,8,0,2" />
                    <TextBox Text="{Binding ResultHex, Mode=OneWay}" IsReadOnly="True" Height="90" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="ASCII 预览" Margin="0,8,0,2" />
                    <TextBox Text="{Binding ResultAscii, Mode=OneWay}" IsReadOnly="True" Height="46" FontFamily="Consolas" />
                    <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding RecoveryText}" Foreground="#555" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="#C62828" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>